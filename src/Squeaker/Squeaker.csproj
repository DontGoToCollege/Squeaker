<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon and the colour dialog. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Squeaker</RootNamespace>
    <AssemblyName>Squeaker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.0.1</Version>
    <Authors>DontGoToCollege</Authors>
    <Product>Squeaker</Product>
    <Description>Mouse cursor customizer for Windows</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
